<?xml version="1.0" encoding="utf-8"?>
<!-- Outer screen while reading: the cover as large as the screen allows, never cropped. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FF000000" android:keepScreenOn="true">
    <ImageView android:id="@+id/cover" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_gravity="center" android:scaleType="fitCenter" />
</FrameLayout>
