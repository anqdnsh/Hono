<?xml version="1.0" encoding="utf-8"?>
<!-- Dark liquid glass for widgets: smoky translucent body, soft top sheen, bright hairline rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient android:angle="270" android:startColor="#B3232326" android:endColor="#CC0A0A0B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient android:angle="270" android:startColor="#1FFFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <stroke android:width="0.8dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
</layer-list>
